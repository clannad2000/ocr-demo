{
  // 相对路径始终以项目根目录为基准。可填写单个PDF或包含PDF的目录（不递归）。
  "pdf": "./book/beast academy math guide 3A.pdf",
  "pages": "1-100",
  // 首次自动生成整书复核计划时使用的目录页。
  "toc_pages": "5-6",
  "long_edge": 2048,
  "workers": 2,
  "verify": "auto",
  // 设为 true 会跳过各阶段之间的 SHA-256 完整性比对；仍会验证文件、结构和内容。
  "ignore_hash_validation": false,
  "resume": false,

  "codex_review": {
    "command": "codex",
    "model": "gpt-5.6-terra",
    "reasoning_effort": "high",
    "timeout_seconds": 1800,
    "toc_image_detail": "high",
    "exclude_preliminary": false,
    "exclude_back_matter": true,
    "image_mode": "on_demand",
    "require_chatgpt_login": true
  },

  "pdf_writer": {
    "font_file": "assets/fonts/simhei.ttf",
    "rules": {
      "minimum_font_size": 7.0,
      "font_size_step": 0.5,
      "line_spacing": 1.25,
      "minimum_write_match_coverage": 0.65,
      "ambiguous_mapping_minimum_coverage": 0.9
    }
  },

  "model_profiles": {
    "deepseek-ocr": {
      "provider": "siliconflow",
      "model": "deepseek-ai/DeepSeek-OCR",
      "api_key_name": "siliconflow",
      "chat_endpoint": "https://api.siliconflow.cn/v1/chat/completions",
      "enable_thinking": false,
      "max_tokens": 4096
    },
    "qwen-flash": {
      "provider": "dashscope",
      "model": "qwen3.6-flash",
      "api_key_name": "dashscope",
      "chat_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "responses_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/responses",
      "enable_thinking": true,
      "max_tokens": 8192
    },
    "qwen-max": {
      "provider": "dashscope",
      "model": "qwen3.7-max-2026-06-08",
      "api_key_name": "dashscope",
      "chat_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "responses_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/responses",
      "enable_thinking": false,
      "max_tokens": 16384
    }
  },
  "model_usage": {
    "layout_ocr": "deepseek-ocr",
    "primary_ocr": "qwen-flash",
    "ocr_verifier": "qwen-max"
  },

  "translation": {
    "provider": "deepl_mcp",
    "endpoint": "https://mcp.deepl.com/v1/mcp",
    "source_lang": "EN",
    "target_lang": "ZH-HANS",
    "formality": "",
    "glossary_id": "",
    "style_id": "",
    "context": "An illustrated Grade 3 mathematics guide for personal study. Translate only the OCR-selected natural-language regions.",
    "custom_instructions": [
      "Translate faithfully and concisely. Do not solve, explain, add, or remove mathematical information.",
      "Preserve all numbers, formulas, operators, page references, and fictional creature names.",
      "Use consistently in geometry: acute angle=锐角; right angle=直角; obtuse angle=钝角; angle=角; side=边; sides=边."
    ],
    "oauth_callback_port": 8765,
    "oauth_keychain_service": "Beast Academy OCR DeepL MCP",
    "oauth_keychain_account": "https://mcp.deepl.com/v1/mcp",
    "node_command": "node",
    "bridge_script": "tools/deepl_mcp_client.mjs"
  }
}
