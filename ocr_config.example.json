{
  // 待处理的PDF文件。相对路径以本配置文件所在目录为基准。
  "pdf": "../beast academy math guide 3A.pdf",
  // 要处理的PDF页码，支持单页、逗号和范围，例如 13-42 或 13,15,20-25。
  "pages": "13-42",
  // 本次任务的输出目录，保存逐页图片、JSON、Markdown和学习页。
  "output": "./runs/chapter1-study-01",
  // 运行日志文件，同时记录终端标准输出和错误输出。
  "log_file": "./runs/chapter1-study-01.log",
  // 处理模式：study 只提取并翻译学习所需英文；exact 识别页面全部文字。
  "mode": "study",
  // PDF页面渲染后图片的长边像素数，越大越清晰，但请求更慢。
  "long_edge": 2048,
  // Homebrew Poppler的pdftoppm绝对路径。Intel Mac通常位于/usr/local，Apple Silicon通常位于/opt/homebrew。
  "pdftoppm_command": "/usr/local/opt/poppler/bin/pdftoppm",
  // 同时处理的PDF页数，建议保持2，避免触发API限流。
  "workers": 2,
  // 复核策略：auto 仅复核风险页；always 每页复核；never 不调用复核模型。
  "verify": "auto",
  // 翻译语义复核：always 每个成功翻译的页面调用一次复核模型；never 关闭。复核只标记问题，不自动改译文。
  "translation_verify": "always",
  // 是否续跑已有输出。首次运行用 false，中断后继续可改为 true。
  "resume": false,
  // 是否只重新语义复核已保存的英中译文。常规运行保持 false，建议通过 --reverify-translation 临时开启。
  "reverify_translation": false,
  // 是否只导出整章文本盲审输入，不调用任何API。常规保持 false，通过 --export-chapter-review 临时开启。
  "export_chapter_review": false,
  // 是否提交一次不含图片的整章高上下文复核。常规保持 false，通过 --chapter-review 临时开启。
  "chapter_review": false,
  // 是否读取Codex裁决并生成独立study-reviewed.html。不会覆盖原始页面JSON或study.html。
  "build_reviewed_study": false,
  // Codex整章裁决JSON路径，相对路径以本配置文件所在目录为基准。
  "adjudication_file": "./runs/chapter1-study-01/chapter_review-codex-adjudication.json",
  // PDF回填设置：与OCR、翻译和模型用途完全解耦，只读取已经保存的最终译文和坐标。
  "pdf_backfill": {
    // 纯中文版输出文件名。相对路径以本次output目录为基准，原始PDF永远不会被覆盖。
    "output_filename": "beast-academy-3A-chapter1-zh-review.pdf",
    // 合并原始译文、Codex裁决和人工覆盖后生成的完整最终译文快照。
    "final_translation_filename": "chapter_translation_final.json",
    // 程序生成的英文区域到原页坐标映射计划，供异常分析和局部修正使用。
    "plan_filename": "pdf_backfill_plan.json",
    // 程序全量技术检查报告；不代表人工视觉验收通过。
    "report_filename": "pdf_backfill_report.json",
    // 仅列出建议由AI抽查的少量高风险页，不会自动调用任何模型。
    "spotcheck_filename": "ai_spotcheck_request.json",
    // 中文字体文件。使用独立TrueType字体并嵌入PDF，避免苹方TTC在macOS快速查看/PDFKit中显示乱码。
    "font_file": "/System/Library/AssetsV2/com_apple_MobileAsset_Font7/eb257c12d1a51c8c661b89f30eec56cacf9b8987.asset/AssetData/STHEITI.ttf",
    // 可选人工译文覆盖文件名；留空表示没有人工文字修改。相对路径以output目录为基准。
    "human_translation_overrides_filename": "",
    // 可选局部版面覆盖文件名；留空表示全部使用自动坐标和全局规则。
    "layout_overrides_filename": "",
    // 由AI根据整章页面类型制定的全局回填规则；代码按规则执行，不让模型逐页回填。
    "rules": {
      // 规则格式版本，用于以后兼容升级。
      "schema_version": 1,
      // 各类文字的默认字号；允许文字溢出气泡，不强制缩小到完全容纳。
      "font_sizes": {
        "dialogue": 11.0,
        "question": 11.0,
        "instruction": 10.0,
        "explanation": 10.0,
        "definition": 10.0,
        "heading": 14.0,
        "contents": 10.0,
        "caption": 10.0,
        "footnote": 9.0,
        "other": 10.0
      },
      // 最小字号，只用于防止覆盖文件设置过小，不做严格气泡适配。
      "minimum_font_size": 9.0,
      // 根据每个文本框的译文长度自动缩小字号；短文保持默认字号。
      "auto_fit_font_size": true,
      // 自动缩小字号时的每次递减值，单位为PDF点。
      "font_size_step": 0.5,
      // 每个文本框相对默认字号最多缩小1点，保留轻微越界以避免中文过小。
      "maximum_auto_font_reduction": 1.0,
      // 中文行距倍数。
      "line_spacing": 1.25,
      // 允许中文越出原气泡范围。
      "allow_bubble_overflow": true,
      // 不把文字严格裁剪在气泡内部。
      "strict_bubble_clipping": false,
      // 中文仍需保留的页面边缘安全距离，单位为PDF点。
      "page_margin_points": 6.0,
      // 自动扩展后文字区域的最小宽度，单位为PDF点。
      "minimum_text_width_points": 72.0,
      // 相对原英文区域允许扩展的最大宽度倍数。
      "maximum_width_expansion": 1.15,
      // 文字块相对原定位框高度可接受的最大比例；超过后继续缩小字号并写入警告。
      "maximum_vertical_overflow_ratio": 1.5,
      // 擦除英文时四周扩展量，顺序为左、上、右、下，坐标范围为0到1000。
      "erase_padding_normalized": [3.0, 2.0, 3.0, 2.0],
      // 中文放置区域四周扩展量，顺序为左、上、右、下，坐标范围为0到1000。
      "placement_padding_normalized": [4.0, 0.0, 4.0, 0.0],
      // 背景修复策略：采样英文框周围颜色并使用近似纯色覆盖，允许轻微瑕疵。
      "background_strategy": "nearby_median",
      // 匹配覆盖率低于该值时保留原英文，不自动擦除和回填。
      "minimum_write_match_coverage": 0.65,
      // 同一译文有多个坐标候选时，只有覆盖率达到该值才自动回填。
      "ambiguous_mapping_minimum_coverage": 0.9,
      // false表示允许高置信度几何定义和图形标签回填；低覆盖率和歧义匹配仍保留英文。
      "skip_dense_geometry_labels": false,
      // 页面至少包含该数量的学习区域时，才可能判定为密集几何图解页。
      "geometry_reference_minimum_regions": 6,
      // 浅色背景上使用的文字颜色。
      "light_text_color": "#111111",
      // 深色背景上使用的文字颜色。
      "dark_text_color": "#FFFFFF",
      // 小于该亮度时视为深色背景并改用白字。
      "dark_background_luminance": 115.0,
      // 不同内容类型的默认对齐方式。
      "alignment_by_type": {
        "dialogue": "center",
        "question": "center",
        "instruction": "left",
        "explanation": "left",
        "definition": "left",
        "heading": "center",
        "contents": "left",
        "caption": "center",
        "footnote": "left",
        "other": "center"
      },
      // 找不到坐标时保留原文并跳过，不阻断整章生成。
      "unmatched_action": "skip",
      // child_note不塞入原气泡，第一版PDF中省略。
      "child_note_action": "omit",
      // 程序对全部页面执行结构、计数、字体和非空检查。
      "program_check": "full",
      // AI只生成抽查清单；设为none可直接进入人工视觉检查。
      "ai_check": "spot",
      // AI建议抽查的高风险页数量，不会自动提交给模型。
      "ai_sample_count": 4,
      // 最终视觉效果必须由人工自行浏览确认。
      "human_visual_review": true
    }
  },
  // 模型信息目录：只定义平台、模型ID、接口和能力，不决定用途。
  "model_profiles": {
    // 硅基流动DeepSeek-OCR配置名。
    "deepseek-ocr": {
      // 平台标识，用于日志和结果归类。
      "provider": "siliconflow",
      // 平台API要求的真实模型ID。
      "model": "deepseek-ai/DeepSeek-OCR",
      // 引用.env中的SILICONFLOW_API_KEY，此处不存密钥。
      "api_key_name": "siliconflow",
      // OpenAI兼容Chat Completions地址。
      "chat_endpoint": "https://api.siliconflow.cn/v1/chat/completions",
      // 是否请求思考模式；null表示不发送该字段。
      "enable_thinking": false,
      // 单次最大输出Token数。
      "max_tokens": 4096
    },
    // DashScope Qwen Flash配置名。
    "qwen-flash": {
      // 平台标识，用于日志和结果归类。
      "provider": "dashscope",
      // 平台API要求的真实模型ID。
      "model": "qwen3.6-flash",
      // 引用.env中的DASHSCOPE_API_KEY。
      "api_key_name": "dashscope",
      // 文本、翻译和主OCR使用的Chat Completions地址。
      "chat_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      // 图像OCR独立复核使用的Responses地址。
      "responses_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/responses",
      // 该配置默认启用思考模式。
      "enable_thinking": true,
      // 单次最大输出Token数。
      "max_tokens": 8192
    },
    // DashScope Qwen Max配置名。
    "qwen-max": {
      // 平台标识，用于日志和结果归类。
      "provider": "dashscope",
      // 平台API要求的真实模型ID。
      "model": "qwen3.7-max-2026-06-08",
      // 引用.env中的DASHSCOPE_API_KEY。
      "api_key_name": "dashscope",
      // 文本和翻译复核使用的Chat Completions地址。
      "chat_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      // 图像OCR独立复核使用的Responses地址。
      "responses_endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/responses",
      // 该配置默认关闭思考模式。
      "enable_thinking": false,
      // 单次最大输出Token数。
      "max_tokens": 16384
    },
    // DeepSeek官方V4整章文本复核配置名。
    "deepseek-v4": {
      // 平台标识，用于日志和结果归类。
      "provider": "deepseek",
      // DeepSeek官方API的真实模型ID。
      "model": "deepseek-v4-pro",
      // 引用.env中的DEEPSEEK_API_KEY。
      "api_key_name": "deepseek",
      // DeepSeek官方Chat Completions地址。
      "chat_endpoint": "https://api.deepseek.com/chat/completions",
      // false会按DeepSeek官方协议发送 thinking.type=disabled，避免长文复核耗尽输出Token。
      "enable_thinking": false,
      // 单次最大输出Token数。
      "max_tokens": 16384
    }
  },
  // 模型使用映射：只把每个工作步骤指向上面的配置名。
  "model_usage": {
    // 版面定位OCR使用的配置名。
    "layout_ocr": "deepseek-ocr",
    // 输出最终英文的主OCR配置名。
    "primary_ocr": "qwen-flash",
    // 图像OCR独立复核使用的配置名。
    "ocr_verifier": "qwen-max",
    // translation.provider=qwen时的翻译配置名。
    "qwen_translation": "qwen-flash",
    // 逐页英中语义复核使用的配置名。
    "translation_verifier": "qwen-max",
    // 可同时选多个；配好DeepSeek密钥后可改为 ["qwen-max", "deepseek-v4"]。
    "chapter_review": ["qwen-max"]
  },
  // DeepL翻译与OAuth MCP连接设置。
  "translation": {
    // 翻译提供方：deepl_mcp 使用DeepL账号OAuth；qwen 使用DashScope翻译。
    "provider": "deepl_mcp",
    // DeepL官方远程MCP服务地址，通常不需要修改。
    "endpoint": "https://mcp.deepl.com/v1/mcp",
    // 源语言代码，EN表示英语。使用术语表时必须明确指定。
    "source_lang": "EN",
    // 目标语言代码，ZH-HANS表示简体中文。
    "target_lang": "ZH-HANS",
    // 正式程度偏好。留空表示使用DeepL默认值。
    "formality": "",
    // DeepL术语表ID。没有术语表时留空。
    "glossary_id": "",
    // DeepL风格规则ID。未配置组织风格规则时留空。
    "style_id": "",
    // 提供给DeepL的上下文，用于说明这是三年级数学教材，最多300字符。
    "context": "An illustrated Grade 3 mathematics guide for personal study. Translate only the OCR-selected natural-language regions.",
    // 翻译约束和术语统一规则，最多10条，每条最多300字符。
    "custom_instructions": [
      // 要求忠实翻译，防止模型解题、扩写或删减信息。
      "Translate faithfully and concisely. Do not solve, explain, add, or remove mathematical information.",
      // 保留数字、公式、页码和书中虚构生物名称。
      "Preserve all numbers, formulas, operators, page references, and fictional creature names such as elefinch and octapug.",
      // 百数表、跳数和多格骨牌类术语的固定译法。
      "Use consistently: skip-counting=跳数; hundred chart=百数表; polyomino=多格骨牌; triomino=三格骨牌; tetromino=四格骨牌.",
      // rep-tile和直线形图形的固定译法。
      "Use consistently: rep-tile=自相似分割图形（rep-tile）; rectilinear shape=直线形图形.",
      // 三角形分类术语的固定译法。
      "Use consistently: scalene triangle=不等边三角形; equilateral triangle=等边三角形; isosceles triangle=等腰三角形.",
      // 角和边的基础术语，避免将acute译为“急性”或将side译为“双方”。
      "Use consistently in geometry: acute angle=锐角; right angle=直角; obtuse angle=钝角; angle=角; side=边; sides=边.",
      // 保留书名和教学语境中的固定含义。
      "Keep Beast Academy as an English brand name. Translate triangle-game instructions literally; do not reinterpret them as relationships."
    ],
    // 本地OAuth回调端口。如果8765被其他程序占用，可改为其他1024-65535端口。
    "oauth_callback_port": 8765,
    // macOS钥匙串中保存OAuth数据的服务名，通常不需要修改。
    "oauth_keychain_service": "Beast Academy OCR DeepL MCP",
    // macOS钥匙串中OAuth数据的账户标识，默认使用MCP地址。
    "oauth_keychain_account": "https://mcp.deepl.com/v1/mcp",
    // 启动MCP辅助进程的Node.js命令，已加入PATH时保持node即可。
    "node_command": "node",
    // 项目内DeepL MCP OAuth辅助脚本路径。
    "bridge_script": "./deepl_mcp_client.mjs"
  }
}
